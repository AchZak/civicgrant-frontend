{
  "name": "civicgrant-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:fr": "ng serve --configuration fr",
    "start:e2e": "ng serve --configuration e2e",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "i18n:extract": "ng extract-i18n --output-path src/locale",
    "api:types": "openapi-typescript ../civicgrant-backend/api/src/main/openapi/openapi.yaml --output src/app/api/schema.ts",
    "lint": "ng lint && tsc --project tsconfig.e2e.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@azure/msal-browser": "^5.30.0",
    "@primeuix/themes": "^3.1.1",
    "primeng": "^22.1.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@angular/localize": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.1.12",
    "angular-eslint": "22.8.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.74.0",
    "vitest": "^5.0.0"
  }
}
